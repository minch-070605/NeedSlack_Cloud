# .env.example — 이 파일을 .env 로 복사해 쓴다. .env 는 커밋하지 않는다.
#
# 규약 (구현설계_MVP.md §5-2)
#   계약값(UPLINK_BPS, S, f_cand, rate, L_max, Q_min)은 여기 두지 않는다.
#   그것은 schema/edge_contract.json 에서 런타임에 읽는다 — 계약이지 설정이 아니다.
#   여기에는 환경 의존값(엔드포인트·자격·경로)만 둔다.

# ── 엔드포인트. 비우면 실제 AWS 를 가리킨다 (M4) ──
AWS_ENDPOINT_S3=http://localhost:9000
AWS_ENDPOINT_DYNAMODB=http://localhost:8000
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=needslack
AWS_SECRET_ACCESS_KEY=needslack-local-secret

MQTT_HOST=localhost
MQTT_PORT=1883

PG_DSN=postgresql://needslack:needslack-local@localhost:5432/needslack

# ── M4 (실제 AWS) — IAM 사용자 ns-m4-admin 의 키. 루트 계정 키를 쓰지 않는다 ──
# 정책: infra/aws/ns-m4-admin-policy.json. 위 AWS_* 는 로컬 스택(MinIO · DynamoDB Local) 자격이라 섞지 않는다.
M4_AWS_ACCESS_KEY_ID=
M4_AWS_SECRET_ACCESS_KEY=
M4_AWS_REGION=ap-northeast-2

# ── rev.9 자산 경로 (읽기 전용. 복사해 오지 않는다) ──
REV9_ROOT=../rev.9    # 이 저장소에는 없다 (경진대회 팀 연구 산출물)

# ── 재생 설정 ──
REPLAY_SPEED=12.5     # 1.0 = 실시간(20 Hz). 상한 12.5 (25 WCU / 2 writes/s)
S3_BUCKET=ns-raw-payload
DATASET_BUCKET=ns-datasets    # 동결 데이터셋 manifest (설계결정-0002)

# ── 콘솔 인코딩 ──
# Windows 콘솔이 cp949 라 한글·em dash 출력이 UnicodeEncodeError 를 낸다.
# rev.9 ns.bat 이 같은 이유로 이 값을 박아 뒀다.
PYTHONUTF8=1
